{
  "extends": "stylelint-config-standard-scss",
  "configBasedir": ".",
  "rules": {
    "indentation": 4,
    "number-leading-zero": "always",
    "selector-class-pattern": null,
    "color-hex-length": "short",
    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": true
  },
  "ignoreFiles": [
    "build/**",
    "dist/**",
    "**/reset*.css",
    "**/bootstrap*.css"
  ]
}