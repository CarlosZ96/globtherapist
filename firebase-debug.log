[debug] [2025-04-21T00:42:56.591Z] <<< [apiv2][body] GET https://cloudfunctions.googleapis.com/v1/projects/globtherapist/locations/-/functions {"functions":[{"name":"projects/globtherapist/locations/us-central1/functions/ext-firestore-send-email-processQueue","description":"Processes document changes in the specified Cloud Firestore collection, delivers emails, and updates the document with delivery status information.","sourceArchiveUrl":"gs://firebase-mod-sources-prod/254b48d99524889d2d5e57540999ab849b3ca410d64e6fcc4ed1929b3195ba13","eventTrigger":{"eventType":"providers/cloud.firestore/eventTypes/document.write","resource":"projects/globtherapist/databases/(default)/documents/mail/{id}","service":"firestore.googleapis.com","failurePolicy":{}},"status":"ACTIVE","entryPoint":"processQueue","timeout":"60s","availableMemoryMb":256,"serviceAccountEmail":"ext-firestore-send-email@globtherapist.iam.gserviceaccount.com","updateTime":"2025-04-07T17:17:18.214Z","versionId":"2","labels":{"goog-dm":"firebase-ext-firestore-send-email","goog-firebase-ext":"firestore-send-email","deployment-tool":"firebase-extensions","goog-firebase-ext-iid":"firestore-send-email","firebase-extensions-ar":"enabled"},"environmentVariables":{"AUTH_TYPE":"UsernamePassword","DATABASE_INSTANCE":"globtherapist-default-rtdb","DATABASE_URL":"https://globtherapist-default-rtdb.firebaseio.com","DEFAULT_FROM":"globtherapist@gmail.com","EXT_INSTANCE_ID":"firestore-send-email","FIREBASE_CONFIG":"{\"projectId\":\"globtherapist\",\"databaseURL\":\"https://globtherapist-default-rtdb.firebaseio.com\",\"storageBucket\":\"globtherapist.firebasestorage.app\"}","GCLOUD_PROJECT":"globtherapist","LOCATION":"us-central1","MAIL_COLLECTION":"mail","OAUTH_PORT":"465","OAUTH_SECURE":"true","PROJECT_ID":"globtherapist","SMTP_CONNECTION_URI":"smtps://globtherapist@gmail.com:ukqmydjbxiakybbn@smtp.gmail.com:465","STORAGE_BUCKET":"globtherapist.firebasestorage.app","TTL_EXPIRE_TYPE":"day","TTL_EXPIRE_VALUE":"1"},"runtime":"nod